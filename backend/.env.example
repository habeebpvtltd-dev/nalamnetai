# Copy this file to .env and fill in real values.
# Never commit .env to git.

# --- App ---
ENVIRONMENT=development
SECRET_KEY=change_this_to_a_64_char_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Database (Supabase PostgreSQL) ---
DATABASE_URL=postgresql://postgres:YOURPASSWORD@db.YOURPROJECT.supabase.co:5432/postgres

# --- AI (Groq & Sarvam) ---
GROQ_API_KEY=gsk_REPLACE_WITH_YOUR_KEY
SARVAM_API_KEY=REPLACE_WITH_SARVAM_KEY
VOICE_STT_PROVIDER=sarvam
VOICE_TTS_PROVIDER=sarvam

# --- Public base URL (used to build QR code links) ---
# Local:      http://10.x.x.x:8000  (your LAN IP)
# Production: https://YOUR-RENDER-APP.onrender.com
PUBLIC_BASE_URL=http://localhost:8000

# --- CORS (comma-separated list of allowed frontend origins) ---
# Local:      http://localhost:8080,http://127.0.0.1:8080,http://10.x.x.x:8080
# Production: https://YOUR-VERCEL-APP.vercel.app
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- OCR ---
TESSERACT_LANG=eng+tam
# Optional: override tesseract binary path (set on Windows, leave unset on Linux/Docker)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Encryption (for medical fields at rest) ---
FIELD_ENCRYPTION_KEY=change_this_to_a_32_byte_key_____
